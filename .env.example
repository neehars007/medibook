# Copy to .env (never commit real secrets). Required in the prod profile.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/medibook
DB_USER=medibook
DB_PASSWORD=change-me
REDIS_HOST=localhost
# openssl rand -base64 32
JWT_SECRET=
# openssl rand -base64 32   (AES-256 key for encrypted clinical columns - losing it means losing the data)
MEDIBOOK_ENCRYPTION_KEY=
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medibook-private
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@medibook.test
FRONTEND_URL=http://localhost:5173
CLINIC_TIMEZONE=America/New_York
# Stripe TEST mode keys; leave blank for simulated payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
